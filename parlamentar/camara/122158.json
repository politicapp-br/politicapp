 da Baixada Fluminense, mulheres com dupla jornada e jovens desempregados, além de vantagens para empregadores dos setores varejista, supermercadista e da construção civil. Por fim, rebateu argumentos contrários à proposta e conclamou a aprovação da matéria na Comissão Especial e no Plenário.","urlTexto":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=27%2F5%2F2026&txPagina=84&txSuplemento=&enviar=Pesquisar"}],"trajetoria":{"mandatosExternos":[{"cargo":"Deputado(a) Estadual","uf":"RJ","municipio":null,"anoInicio":2006,"anoFim":2010,"partido":null},{"cargo":"Deputado(a) Estadual","uf":"RJ","municipio":null,"anoInicio":2006,"anoFim":2010,"partido":"MDB"}],"ocupacoes":[{"titulo":"Secretário Municipal","entidade":"Secretaria Municipal de Fazenda e Planejamento","anoInicio":2021,"anoFim":null},{"titulo":"Chefe da Casa Civil","entidade":"Prefeitura Municipal","anoInicio":2009,"anoFim":null},{"titulo":"Secretário Municipal","entidade":"Secretaria Municipal do Meio Ambiente","anoInicio":2002,"anoFim":null}]}}
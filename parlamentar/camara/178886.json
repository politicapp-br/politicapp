amara","id":"2596314","sigla":"REC","numero":30,"ano":2025,"ementa":"Recurso contra a tramitação conclusiva do Projeto de Lei nº 2.614/2024, que \"aprova o Plano Nacional de Educação para o decênio 2024-2034\".","resumo":null,"apresentadaEm":"2025-12-11T18:52","situacao":null,"temas":[]},{"casa":"camara","id":"2582496","sigla":"REQ","numero":4711,"ano":2025,"ementa":"Requer o registro, no âmbito da Câmara dos Deputados, da Frente Parlamentar “Frente Parlamentar em Defesa da Ética na Saúde Suplementar”.","resumo":null,"apresentadaEm":"2025-11-06T17:23","situacao":null,"temas":[]},{"casa":"camara","id":"2582320","sigla":"PL","numero":5713,"ano":2025,"ementa":"Altera a Lei nº 9.472, de 16 de julho de 1997, e a Lei n° 12.965, de 23 de abril de 2014, para dispor sobre a utilização de recursos de numeração por provedores de aplicações de internet.","resumo":null,"apresentadaEm":"2025-11-06T08:33","situacao":null,"temas":[]},{"casa":"camara","id":"2582199","sigla":"REQ","numero":4700,"ano":2025,"ementa":"Requer o registro da Frente Parlamentar Mista de Telecomunicações e Soluções Digitais.","resumo":null,"apresentadaEm":"2025-11-05T18:25","situacao":null,"temas":[]}],"orgaos":[{"sigla":"CSAUDE","nome":"Comissão de Saúde","papel":"Suplente","inicio":"2026-04-17T00:00","fim":null},{"sigla":"CCOM","nome":"Comissão de Comunicação","papel":"Titular","inicio":"2026-04-17T00:00","fim":null}],"discursos":[{"data":"2026-08-12T19:40","tipo":"COMO LÍDER","resumo":"O Deputado defendeu o Projeto de Lei Complementar nº 230, de 2025, que altera a Lei Complementar nº 101, de 2000, para vedar a limitação de empenho e movimentação financeira das despesas relativas ao Fundo de Universalização dos Serviços de Telecomunicações (Fust), e a Lei nº 9.998, de 2000, para os fins que especifica. Argumentou favoravelmente à renovação do Fust e o não contingenciamento dos recursos, ao ressaltar que o fundo passou a ser executado em sua integralidade a partir de 2023. Além disso, apontou a aplicação de 3,8 bilhões de reais em conectividade, com apoio a provedores, Municíp…","urlTexto":null},{"data":"2026-06-16T20:28","tipo":"ENCAMINHAMENTO DE VOTAÇÃO","resumo":"O Deputado encaminhou a votação do requerimento de urgência para apreciação do Projeto de Lei Complementar nº 230, de 2025, que altera a Lei Complementar nº 101, de 4 de maio de 2000, para vedar a limitação de empenho e movimentação financeira das despesas relativas ao Fundo de Universalização dos Serviços de Telecomunicações, e a Lei nº 9.998, de 17 de agosto de 2000, para os fins que especifica. Afirmou que, nos últimos três anos, foram viabilizados mais de R$ 3 bilhões em investimentos, com empréstimos subsidiados, recursos a fundo perdido e renúncia fiscal, inclusive para conectar milhares…","urlTexto":null},{"data":"2026-05-19T17:20","tipo":"ENCAMINHAMENTO DE VOTAÇÃO","resumo":"O Deputado encaminhou a votação do requerimento de urgência ao Projeto de Lei nº 3.220, de 2019, que dispõe sobre o compartilhamento de infraestrutura física aérea de titularidade de prestadoras de serviços de distribuição de energia elétrica com prestadoras de serviços de telecomunicações, altera a Lei nº 9.427, de 26 de dezembro de 1996, a Lei nº 9.472, de 16 de julho de 1997, e a Lei nº 14.947, de 2 de agosto de 2024, e dá outras providências.","urlTexto":"https://imagem.camara.gov.br/dc_20b.asp?largura=&altura=&tipoForm=diarios&selCodColecaoCsv=D&Datain=20%2F5%2F2026&txPagina=135&txSuplemento=&enviar=Pesquisar"}],"trajetoria":{"mandatosExternos":[],"ocupacoes":[{"titulo":"Médico","entidade":"CADI","anoInicio":2014,"anoFim":null}]}}
ll,"temas":[]},{"casa":"camara","id":"2641988","sigla":"PRL","numero":1,"ano":0,"ementa":"Parecer da Relatora, Dep. Sônia Guajajara (PSOL-SP), pela aprovação, na forma do Substitutivo da Comissão de Integração Nacional e Desenvolvimento Regional.","resumo":null,"apresentadaEm":"2026-08-04T17:09","situacao":null,"temas":[]},{"casa":"camara","id":"2641987","sigla":"PRL","numero":1,"ano":0,"ementa":"Parecer da Relatora, Dep. Sonia Guajajara (PSOL-SP), pela aprovação.","resumo":null,"apresentadaEm":"2026-08-04T17:20","situacao":null,"temas":[]},{"casa":"camara","id":"2641590","sigla":"PRC","numero":41,"ano":2026,"ementa":"Estabelece a exigência de discussão e votação presenciais, no Plenário da Câmara dos Deputados, das matérias de alta relevância socioambiental.","resumo":null,"apresentadaEm":"2026-07-24T13:32","situacao":null,"temas":[]},{"casa":"camara","id":"2640243","sigla":"RDF","numero":1,"ano":0,"ementa":"Redação Final ao PL 3839/2023","resumo":null,"apresentadaEm":"2026-07-15T00:00","situacao":null,"temas":[]},{"casa":"camara","id":"2639690","sigla":"SBT","numero":1,"ano":0,"ementa":"Sem ementa disponível","resumo":null,"apresentadaEm":"2026-07-15T12:45","situacao":null,"temas":[]},{"casa":"camara","id":"2639685","sigla":"PPP","numero":1,"ano":0,"ementa":"Parecer proferido em Plenário pela Relatora, Dep. Sônia Guajajara (PSOL-SP) pela: • Comissão da Amazônia e dos Povos Originários e Tradicionais, que conclui pela aprovação do Projeto de Lei nº 3.839, de 2023, na forma do Substitutivo adotado. • Comissão de Constituição e Justiça e de Cidadania, que conclui pela constitucionalidade, juridicidade e boa técnica legislativa do Projeto de Lei nº 3.839, de 2023; e, no mérito, pela sua aprovação, na forma do Substitutivo adotado pela relatora da Comissão da Amazônia e dos Povos Originários e Tradicionais.","resumo":null,"apresentadaEm":"2026-07-15T11:00","situacao":null,"temas":[]},{"casa":"camara","id":"2639418","sigla":"PRLP","numero":2,"ano":0,"ementa":"Autoriza o uso de fotografia de identificação com elemento de indumentária tradicional que exprime a identidade da pessoa, bem como altera as leis nº 7.116, de 29 de agosto de 1983, nº 9.503, de 23 de setembro de 1997 (Código de Trânsito Brasileiro) e o Decreto-Lei nº 5.452, de 1º de maio de 1943 (Consolidação das Leis do Trabalho).","resumo":null,"apresentadaEm":"2026-07-14T13:47","situacao":null,"temas":[]},{"casa":"camara","id":"2638801","sigla":"REQ","numero":86,"ano":2026,"ementa":"Requer a realização de Audiência Pública para discutir a criação da Comissão Nacional Indígena da Verdade e as políticas de memória, verdade, reparação integral, justiça e não repetição para os Povos Indígenas.","resumo":null,"apresentadaEm":"2026-07-09T17:57","situacao":null,"temas":[]},{"casa":"camara","id":"2638800","sigla":"REQ","numero":85,"ano":2026,"ementa":"Requer a aprovação de Moção de Aplausos ao 59º Festival Folclórico de Parintins e à vitória do Boi Caprichoso, pela importância desses acontecimentos para a visibilidade, a valorização e o fortalecimento das culturas indígenas e ribeirinhas da Amazônia.","resumo":null,"apresentadaEm":"2026-07-09T17:57","situacao":null,"temas":[]},{"casa":"camara","id":"2638686","sigla":"REQ","numero":84,"ano":2026,"ementa":"Requer a realização de Audiência Pública para discutir a adoção de medidas de saúde pública para o enfrentamento dos altos índices de contaminação por mercúrio entre gestantes e crianças nas áreas de garimpo ilegal na Amazônia.","resumo":null,"apresentadaEm":"2026-07-09T15:58","situacao":null,"temas":[]},{"casa":"camara","id":"2637606","sigla":"PRLP","numero":1,"ano":0,"ementa":"Autoriza o uso de fotografia de identificação com elemento de indumentária tradicional que exprime a identidade da pessoa, bem como altera as leis nº 7.116, de 29 de agosto de 1983, nº 9.503, de 23 de setembro de 1997 (Código de Trânsito Brasileiro) e o Decreto-Lei nº 5.452, de 1º de maio de 1943 (Consolidação das Leis do Trabalho).","resumo":null,"apresentadaEm":"2026-07-07T13:33","situacao":null,"temas":[]},{"casa":"camara","id":"2635537","sigla":"RPD","numero":1,"ano":0,"ementa":"Requerimento de Inclusão de Matéria na Ordem do Dia para Apreciação Imediata - REQ 69/2026 CPOVOS","resumo":null,"apresentadaEm":"2026-06-30T13:23","situacao":null,"temas":[]},{"casa":"camara","id":"2635498","sigla":"REQ","numero":69,"ano":2026,"ementa":"Requer a realização de seminário no Sul de Minas Gerais para debater a exploração de terras raras e seus impactos socioambientais, com ênfase na proteção dos territórios, dos direitos e dos modos de vida de comunidades tradicionais e povos indígenas, bem como na promoção de uma transição energética justa e sustentável.","resumo":null,"apresentadaEm":"2026-06-30T12:04","situacao":null,"temas":[]}],"orgaos":[{"sigla":"SUBTRAMZ","nome":"Subcomissão Especial destinada a discutir os impactos da exploração de minerais críticos e de terras raras nos territórios indígenas e de povos e comunidades tradicionais","papel":"Titular","inicio":"2026-05-11T00:00","fim":null},{"sigla":"CCULT","nome":"Comissão de Cultura","papel":"Suplente","inicio":"2026-04-27T00:00","fim":null},{"sigla":"CPOVOS","nome":"Comissão da Amazônia e dos Povos Originários e Tradicionais","papel":"Titular","inicio":"2026-04-06T00:00","fim":null},{"sigla":"SEMULHER","nome":"Secretaria da Mulher","papel":"Titular","inicio":"2026-03-31T00:00","fim":null}],"discursos":[{"data":"2026-07-15T13:12","tipo":"PELA ORDEM","resumo":"A Deputada agradeceu aos Parlamentares e às bancadas que orientaram “sim” pela aprovação do Projeto de Lei nº 3.839, de 2023, e afirmou que a decisão do Congresso Nacional reconheceu a identidade brasileira como plural e diversa. Além disso, explicou que o padrão anterior de fotos negava a identidade dos povos indígenas, enquanto a nova regra se ajusta ria às tecnologias atuais, que identificam a face e não acessórios. Por fim, parabenizou a Deputada Célia pela iniciativa.","urlTexto":null},{"data":"2026-07-15T12:40","tipo":"PARECER","resumo":"A Deputada proferiu parecer ao Projeto de lei nº 3.839, de 2023, que autoriza o uso de fotografia de identificação com elemento de indumentária tradicional que exprime a identidade da pessoa, bem como altera as leis nº 7.116, de 29 de agosto de 1983, nº 9.503, de 23 de setembro de 1997 (Código de Trânsito Brasileiro) e o Decreto-Lei nº 5.452, de 1º de maio de 1943 (Consolidação das Leis do Trabalho).","urlTexto":null}],"trajetoria":{"mandatosExternos":[],"ocupacoes":[{"titulo":"Ministra de Estado","entidade":"Ministério dos Povos Indígenas do Brasil","anoInicio":2023,"anoFim":null}]}}
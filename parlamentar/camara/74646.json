null,"temas":[]},{"casa":"camara","id":"2462876","sigla":"REQ","numero":4259,"ano":2024,"ementa":"Requer o registro da Frente Parlamentar Mista dos Correspondentes Bancários.","resumo":null,"apresentadaEm":"2024-10-16T17:24","situacao":null,"temas":[]},{"casa":"camara","id":"2459627","sigla":"RCP","numero":3,"ano":2024,"ementa":"Requer a criação de Comissão Parlamentar de Inquérito destinada a investigar denúncias de estupro contra mulheres no Brasil e levantar as possíveis causas para a associação desse crime com os tipos de violência contra mulher.","resumo":null,"apresentadaEm":"2024-09-30T18:38","situacao":null,"temas":[]},{"casa":"camara","id":"2450515","sigla":"PL","numero":3009,"ano":2024,"ementa":"Disciplina a convocação de cadeia de rádio e televisão para pronunciamentos oficiais e dá outras providências.","resumo":null,"apresentadaEm":"2024-07-31T10:19","situacao":null,"temas":[]}],"orgaos":[{"sigla":"CFT","nome":"Comissão de Finanças e Tributação","papel":"Suplente","inicio":"2026-03-18T00:00","fim":null},{"sigla":"CREDN","nome":"Comissão de Relações Exteriores e de Defesa Nacional","papel":"Titular","inicio":"2026-02-03T00:00","fim":null}],"discursos":[{"data":"2026-09-02T11:44","tipo":"PELA ORDEM","resumo":"O Deputado orientou favoravelmente a Federação PSDB Cidadania na votação do&nbsp;Projeto de Decreto Legislativo nº 995, de 2026, que indica o Senador Rodrigo Pacheco para o cargo de Ministro do Tribunal de Contas da União (TCU). Além disso, elogiou a trajetória e a atuação pública do indicado e destacou sua contribuição ao País em períodos recentes de incerteza.","urlTexto":null},{"data":"2026-09-02T11:24","tipo":"PARECER","resumo":"O Deputado proferiu parecer favorável ao Projeto de Decreto Legislativo nº 995, de 2026, que indica o Senador Rodrigo Pacheco para o cargo de Ministro do Tribunal de Contas da União (TCU), na vaga decorrente da renúncia do Ministro Bruno Dantas. Além disso, destacou a trajetória jurídica e política do indicado, sua atuação na Presidência do Senado Federal e do Congresso Nacional e seu papel na defesa da democracia e das instituições durante períodos de tensão institucional. Por fim, ressaltou a moderação, o equilíbrio, a capacidade de diálogo e a experiência de Rodrigo Pacheco e afirmou que su…","urlTexto":null},{"data":"2026-05-20T15:44","tipo":"PELA ORDEM","resumo":"O Deputado saudou a posse, na Casa, do Deputado Glycon, do Partido da Social Democracia Brasileira (PSDB), e afirmou que sua trajetória fortalece a reconstrução da legenda e a construção de um caminho para o Brasil, sem vinculação aos extremos. Ademais, defendeu a política feita com seriedade e responsabilidade como instrumento de transformação social e sustentou que o PSDB deve dialogar com diferentes vertentes políticas, superar ataques a adversários e priorizar a vida dos brasileiros.","urlTexto":null}],"trajetoria":{"mandatosExternos":[],"ocupacoes":[{"titulo":"Diretor","entidade":"Diretoria de Loterias da Caixa Econômica - CEF","anoInicio":1985,"anoFim":1986},{"titulo":"Diretor de Loterias","entidade":"CEF","anoInicio":1985,"anoFim":1986},{"titulo":"Secretário Particular para Assuntos Especiais","entidade":"Presidência da República","anoInicio":1985,"anoFim":null},{"titulo":"Secretário Particular para Assuntos Especiais","entidade":"Presidência da República","anoInicio":1985,"anoFim":null},{"titulo":"Secretário Particular do Governador Tancredo Neves","entidade":null,"anoInicio":1983,"anoFim":1984},{"titulo":"Secretário","entidade":"Gabinete do Governo do Estado","anoInicio":1983,"anoFim":1984},{"titulo":"Secretário Parlamentar","entidade":"Gabinete Parlamentar na Câmara dos Deputados","anoInicio":1980,"anoFim":1983},{"titulo":"Chefe de Gabinete","entidade":"Conselho Administrativo de Defesa Econômica - CADE  do Ministério da Justiça","anoInicio":1977,"anoFim":null},{"titulo":"Secretário de Gabinete Parlamentar","entidade":"2/1/1980 a 16/3/1983(*)","anoInicio":null,"anoFim":null},{"titulo":"Economista","entidade":"Banco de Desenvolvimento de Minas Gerais - BDMG","anoInicio":null,"anoFim":null},{"titulo":"Economista","entidade":"BDMG","anoInicio":null,"anoFim":null}]}}
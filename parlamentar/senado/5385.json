null},{"sigla":"GPCHINA","nome":"Grupo Parlamentar Brasil - China","papel":"Titular","inicio":"2023-05-09","fim":null},{"sigla":"GPBAHREIN","nome":"Grupo Parlamentar Brasil - Bahrein","papel":"Titular","inicio":"2023-09-13","fim":null},{"sigla":"GP-BRICS-SF","nome":"Grupo Parlamentar de Relacionamento com o BRICS","papel":"Titular","inicio":"2023-06-15","fim":null},{"sigla":"FPJOVEM","nome":"Frente Parlamentar em Defesa das Políticas Públicas de Juventude","papel":"Titular","inicio":"2023-10-25","fim":null},{"sigla":"CAE","nome":"Comissão de Assuntos Econômicos","papel":"Titular","inicio":"2025-02-18","fim":null},{"sigla":"CI","nome":"Comissão de Serviços de Infraestrutura","papel":"Titular","inicio":"2025-02-18","fim":null},{"sigla":"DJEM","nome":"Conselho do Diploma José Ermírio de Moraes","papel":"Titular","inicio":"2026-04-01","fim":null},{"sigla":"CPCMS","nome":"Representação Brasileira no Parlamento do Mercosul","papel":"Suplente","inicio":"2023-08-23","fim":null},{"sigla":"CCJ","nome":"Comissão de Constituição, Justiça e Cidadania","papel":"Suplente","inicio":"2025-08-19","fim":null},{"sigla":"CRE","nome":"Comissão de Relações Exteriores e Defesa Nacional","papel":"Suplente","inicio":"2025-02-18","fim":null},{"sigla":"CMA","nome":"Comissão de Meio Ambiente","papel":"Suplente","inicio":"2025-02-18","fim":null}],"discursos":[{"data":"2026-07-14","tipo":"Como Relator","resumo":"Como Relator sobre a Proposta de Emenda à Constituição (PEC) n° 14, de 2021, que \"Altera os arts. 40, 198 e 201 da Constituição Federal, para estabelecer o direito à aposentadoria diferenciada aos agentes comunitários de saúde e aos agentes de combate às endemias, bem como para determinar a regularização do vínculo funcional desses agentes; e dá outras providências.\" Defesa da aposentadoria especial dos agentes comunitários de saúde e de combate às endemias. Destaque para a importância da atuação dessas categorias na atenção básica de saúde pública.","urlTexto":"https://www25.senado.leg.br/web/atividade/pronunciamentos/-/p/texto/523649"},{"data":"2026-06-30","tipo":"Pela ordem","resumo":"Pela ordem sobre a Proposta de Emenda à Constituição (PEC) n° 14, de 2021, que \"Altera os arts. 40, 198 e 201 da Constituição Federal, para estabelecer o direito à aposentadoria diferenciada aos agentes comunitários de saúde e aos agentes de combate às endemias, bem como para determinar a regularização do vínculo funcional desses agentes; e dá outras providências.\"","urlTexto":"https://www25.senado.leg.br/web/atividade/pronunciamentos/-/p/texto/523157"},{"data":"2026-06-17","tipo":"Não classificado","resumo":"Não classificado sobre a Proposta de Emenda à Constituição (PEC) n° 14, de 2021, que \"Altera os arts. 40, 198 e 201 da Constituição Federal, para estabelecer o direito à aposentadoria diferenciada aos agentes comunitários de saúde e aos agentes de combate às endemias, bem como para determinar a regularização do vínculo funcional desses agentes; e dá outras providências.\"","urlTexto":"https://www25.senado.leg.br/web/atividade/pronunciamentos/-/p/texto/522991"},{"data":"2026-06-17","tipo":"Pela ordem","resumo":"Pela ordem sobre o Requerimento (RQS) n° 454, de 2026, que \"Requer calendário especial para a Proposta de Emenda à Constituição nº 14/2021, que \"Altera os arts. 40, 198 e 201 da Constituição Federal, para estabelecer o direito à aposentadoria diferenciada aos agentes comunitários de saúde e aos agentes de combate às endemias, bem como para determinar a regularização do vínculo funcional desses agentes; e dá outras providências.\"","urlTexto":"https://www25.senado.leg.br/web/atividade/pronunciamentos/-/p/texto/522989"},{"data":"2026-06-10","tipo":"Pela ordem","resumo":"Pela ordem sobre a Proposta de Emenda à Constituição (PEC) n° 14, de 2021, que \"Altera os arts. 40, 198 e 201 da Constituição Federal, para estabelecer o direito à aposentadoria diferenciada aos agentes comunitários de saúde e aos agentes de combate às endemias, bem como para determinar a regularização do vínculo funcional desses agentes; e dá outras providências.\" Comemoração pela aprovação da matéria na Comissão de Constituição, Justiça e Cidadania (CCJ) e apela pela aprovação de calendário especial para sua tramitação.","urlTexto":"https://www25.senado.leg.br/web/atividade/pronunciamentos/-/p/texto/522652"},{"data":"2026-05-27","tipo":"Pela Liderança","resumo":"Satisfação com a aprovação, na presente sessão, do Projeto de Lei nº 5228/2019, de autoria de S. Exa., que altera a Consolidação das Leis do Trabalho (CLT) para instituir o contrato de primeiro emprego e o contrato de recolocação profissional.","urlTexto":"https://www25.senado.leg.br/web/atividade/pronunciamentos/-/p/texto/522424"},{"data":"2026-05-26","tipo":"Discurso","resumo":"Registro da atuação parlamentar de S. Exª. pautado pelo posicionamento contrário ao aumento da carga tributária, à retirada de direitos trabalhistas e a projetos que interfiram no direito à vida.","urlTexto":"https://www25.senado.leg.br/web/atividade/pronunciamentos/-/p/texto/522347"}]}
im":null},{"sigla":"CAS","nome":"Comissão de Assuntos Sociais","papel":"Titular","inicio":"2026-03-17","fim":null},{"sigla":"CMA","nome":"Comissão de Meio Ambiente","papel":"Titular","inicio":"2026-03-17","fim":null},{"sigla":"CEsp","nome":"Comissão de Esporte","papel":"Titular","inicio":"2026-03-24","fim":null},{"sigla":"CDHYANOM","nome":"Subcomissão Permanente dos povos  indígenas Yanomami","papel":"Titular","inicio":"2026-04-28","fim":null},{"sigla":"CDH","nome":"Comissão de Direitos Humanos e Legislação Participativa","papel":"Suplente","inicio":"2026-03-17","fim":null},{"sigla":"CE","nome":"Comissão de Educação e Cultura","papel":"Suplente","inicio":"2026-03-17","fim":null}],"discursos":[{"data":"2026-08-12","tipo":"Não classificado","resumo":"Encerramento de sessão especial destinada a celebrar os 100 anos da Associação Brasileira de Enfermagem (ABEn Nacional).","urlTexto":"https://www25.senado.leg.br/web/atividade/pronunciamentos/-/p/texto/523799"},{"data":"2026-08-12","tipo":"Discurso","resumo":"Sessão especial destinada a celebrar os 100 anos da Associação Brasileira de Enfermagem (ABEn Nacional), destacando sua contribuição para a formação profissional, a produção científica e o fortalecimento da enfermagem brasileira. Destaque para o papel essencial da enfermagem na prevenção, assistência, recuperação e acolhimento da população em todo o país. Manifestação de apoio à aprovação da PEC nº 19, comprometendo-se a atuar pela valorização e pelo reconhecimento dos profissionais da categoria.","urlTexto":"https://www25.senado.leg.br/web/atividade/pronunciamentos/-/p/texto/523793"},{"data":"2026-07-15","tipo":"Discurso","resumo":"Alerta sobre o alto custo das passagens aéreas no Estado de Roraima, com destaque para o impacto das altas tarifas na mobilidade, o acesso a serviços essenciais e ao desenvolvimento local. Registro de apresentação do Requerimento de Informações nº 530/2026, de autoria de S. Exa, ao Ministério de Portos e Aeroportos. Cobrança de medidas que assegurem à população do Estado acesso a transporte aéreo compatível com as particularidades da Região Norte.","urlTexto":"https://www25.senado.leg.br/web/atividade/pronunciamentos/-/p/texto/523518"},{"data":"2026-07-08","tipo":"Discurso","resumo":"Defesa do Projeto de Lei nº 1812/2026, que estabelece novas regras do Benefício de Prestação Continuada (BPC), de autoria de S. Exa.. Registro de assinatura em voto de repúdio apresentado pela Bancada Feminina do Senado Federal em razão das ofensas dirigidas à Senadora\nDamares Alves por apoiadores da pré-candidatura de Flávio Bolsonaro à Presidência da República.","urlTexto":"https://www25.senado.leg.br/web/atividade/pronunciamentos/-/p/texto/523453"},{"data":"2026-06-17","tipo":"Como Relator","resumo":"Como Relator sobre o Projeto de Lei (PL) n° 6113, de 2023, que \"Cria o Banco Nacional de Boas Práticas na Prevenção e no Combate à Violência contra a Mulher.\" Destaca o potencial do banco de dados em catalogar, compartilhar e replicar experiências administrativas e assistenciais exitosas por todo o país.","urlTexto":"https://www25.senado.leg.br/web/atividade/pronunciamentos/-/p/texto/523024"},{"data":"2026-06-16","tipo":"Comunicação inadiável","resumo":"Manifestação de apoio à derrubada do Veto nº 50/2025, aposto ao Projeto de Lei nº 1791/2019, para garantir o aproveitamento de empregados públicos de estatais elétricas desestatizadas em empresas públicas ou sociedades de economia mista em funções compatíveis com suas atribuições e remunerações, uma vez que não há criação de despesa à União.","urlTexto":"https://www25.senado.leg.br/web/atividade/pronunciamentos/-/p/texto/522914"},{"data":"2026-05-20","tipo":"Discurso","resumo":"Preocupação com o aumento da tarifa de energia elétrica em Roraima após a integração do Estado ao Sistema Interligado Nacional, com críticas ao reajuste inicialmente previsto demais de 24% nas contas de luz.","urlTexto":"https://www25.senado.leg.br/web/atividade/pronunciamentos/-/p/texto/522200"}]}